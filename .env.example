FLASK_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key
ADMIN_PASSWORD=your-admin-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-user
SMTP_PASSWORD=your-pass
SMTP_SENDER=notifications@example.com
SMTP_ENCRYPTION=tls
# Comma-separated phone numbers to ignore in WhatsApp webhooks (digits only OK)
IGNORED_PHONES=
# Owner phone for diagnostic / flask --test WhatsApp (never volunteer numbers)
WHATSAPP_TEST_PHONE=+48697495755
# When 1, ALL WhatsApp is redirected to WHATSAPP_TEST_PHONE (do not leave on in prod)
# WHATSAPP_FORCE_TEST_RECIPIENT=1
# Monthly summary recipient (scheduler)
COORDINATOR_EMAIL=mappel@op.pl
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
