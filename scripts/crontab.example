# DEPRECATED for production.
# Scheduled jobs now run inside Docker Compose (service: `scheduler`,
# file: scripts/crontab, TZ=Europe/Warsaw). Deploying this repo on any
# host with `docker compose up -d` is enough — no host crontab needed.
#
# Keep this file only as a reference / emergency fallback.
# If you must use host cron, use Unix LF only (never CRLF / literal \r
# after 2>&1) and account for the host timezone.

# Volunteer reminders (adjust hours if host is UTC)
# 0 16 * * * cd /path/to/treningi && docker compose exec -T web flask send-reminders

# Coach summary
# */30 6-16 * * * cd /path/to/treningi && docker compose exec -T web flask send-coach-summary

# Prefer: docker compose up -d scheduler
